# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# --- Data (download from Kaggle, never commit) ---
data/raw/*
data/processed/*
!data/processed/summary.json
data/partitions/*
data/processed_*/
data/partitions_*/
!data/**/.gitkeep

# --- Models / experiment outputs ---
# Only the small per-seed results are committed (summaries, histories, audit hashes, alerts, the
# tiny saved models); per-transaction scores and old local runs stay on each machine.
experiments/results/**/scores/
experiments/results/archive/
*.pt
*.pth
*.ckpt
mlruns/
wandb/

# --- Blockchain (Hardhat) ---
node_modules/
**/hardhat/artifacts/
**/hardhat/cache/
**/hardhat/typechain-types/
**/hardhat/deployments/
coverage/

# --- Secrets ---
.env
.env.*
*.key

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/
